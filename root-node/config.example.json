{
  "dataDir": "~/.local/share/peercompute/root",
  "port": 5199,
  "chromePath": "/usr/bin/google-chrome",
  "chromeArgs": ["--enable-gpu", "--enable-unsafe-webgpu"],
  "bootstrapPeers": [],
