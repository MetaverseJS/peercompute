{
  "name": "@peercompute/geodata-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded real-world geodata catalog and OpenStreetMap region adapter for PeerCompute demos.",
  "type": "module",
  "main": "src/app.js",
  "exports": {
    ".": "./src/app.js",
    "./config": "./src/config.js",
    "./osm": "./src/osm/normalize.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:syntax": "rg --files src test -g '*.js' | sort | xargs -n1 node --check"
  },
  "dependencies": {
    "@peercompute/geo-core": "file:../../packages/geo-core",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  }
}
