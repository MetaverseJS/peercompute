{
  "name": "peercompute-root",
  "private": true,
  "workspaces": [
    "peercompute",
    "demos/hyperborea",
    "demos/cubechat",
    "demos/daddygo",
    "demos/netviz",
    "demos/planetgen",
    "demos/universes",
    "demos/webgpuphys",
    "demos/sneakywoods"
  ],
  "scripts": {
    "dev:relay": "npm --prefix peercompute run relay",
    "dev:hyperborea": "npm --prefix demos/hyperborea run dev -- --host",
    "dev:cubechat": "npm --prefix demos/cubechat run dev -- --host",
    "dev:planetgen": "npm --prefix demos/planetgen run dev -- --host",
    "dev:universes": "npm --prefix demos/universes run dev -- --host",
    "dev:webgpuphys": "npm --prefix demos/webgpuphys run dev -- --host",
    "dev:sneakywoods": "npm --prefix demos/sneakywoods run dev -- --host",
    "dev:daddygo": "npm --prefix demos/daddygo run dev -- --host",
    "dev:netviz": "npm --prefix demos/netviz run dev -- --host",
    "dev": "bash scripts/dev-all.sh",
    "dev:local-relay": "bash scripts/dev-local-relay.sh",
    "chaos:lab": "npm --prefix net-chaos-lab run chaos-lab --",
    "chaos-lab": "npm --prefix net-chaos-lab run chaos-lab --",
    "chaos-lab:full": "npm --prefix net-chaos-lab run full --",
    "chaos-lab:matrix": "npm --prefix net-chaos-lab run matrix --",
    "chaos-lab:matrix:demos": "npm --prefix net-chaos-lab run matrix:demos --",
    "chaos-lab:matrix:full": "npm --prefix net-chaos-lab run matrix:full --",
    "chaos-lab:matrix:demos:full": "npm --prefix net-chaos-lab run matrix:demos:full --",
    "chaos-lab:matrix:loop": "npm --prefix net-chaos-lab run matrix:loop --",
    "chaos-lab:matrix:demos:loop": "npm --prefix net-chaos-lab run matrix:demos:loop --",
    "chaos-lab:matrix:watch": "npm --prefix net-chaos-lab run matrix:watch --",
    "chaos-lab:matrix:smoke": "npm --prefix net-chaos-lab run matrix:smoke --",
    "chaos-lab:ipv6:min": "npm --prefix net-chaos-lab run ipv6:min --",
    "chaos-lab:ipv6:min:all": "npm --prefix net-chaos-lab run ipv6:min:all --",
    "chaos-lab:ipv6:loop": "npm --prefix net-chaos-lab run ipv6:loop --",
    "chaos-lab:image:build": "npm --prefix net-chaos-lab run image:build --",
    "chaos-lab:cleanup": "npm --prefix net-chaos-lab run cleanup --",
    "chaos-lab:deps": "npm --prefix net-chaos-lab run deps:python --",
    "docs:dev": "vite --config vite.docs.config.mjs",
    "docs:preview": "vite preview --config vite.docs.config.mjs",
    "test:runtime": "node demos/tests/runtime-smoke.mjs && node demos/tests/runtime-p2p.mjs",
    "test:runtime:p2p": "node demos/tests/runtime-p2p.mjs",
    "build:hyperborea": "npm --prefix demos/hyperborea run build",
    "build:cubechat": "npm --prefix demos/cubechat run build",
    "build:planetgen": "npm --prefix demos/planetgen run build",
    "build:universes": "npm --prefix demos/universes run build",
    "build:webgpuphys": "npm --prefix demos/webgpuphys run build",
    "build:sneakywoods": "npm --prefix demos/sneakywoods run build",
    "build:daddygo": "npm --prefix demos/daddygo run build",
    "build:netviz": "npm --prefix demos/netviz run build",
    "build:peercompute": "npm --prefix peercompute run build",
    "build:demos": "npm run build:hyperborea && npm run build:cubechat && npm run build:planetgen && npm run build:universes && npm run build:webgpuphys && npm run build:sneakywoods && npm run build:daddygo && npm run build:netviz",
    "build:all": "bash scripts/build-all.sh",
    "build": "npm run build:all"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@libp2p/utils": "^7.0.9",
    "three": "^0.182.0"
  },
  "overrides": {
    "@libp2p/utils": "^7.0.9"
  }
}
