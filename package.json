{
  "name": "peercompute-root",
  "private": true,
  "workspaces": [
    "packages/geo-core",
    "services/geodata",
    "peercompute",
    "demos/earth",
    "demos/motorcycle",
    "demos/hyperborea",
    "demos/cubechat",
    "demos/daddygo",
    "demos/fano-reactor",
    "demos/netviz",
    "demos/planetgen",
    "demos/wxglobe",
    "demos/multiscale",
    "demos/schrodinger",
    "demos/universes",
    "demos/webgpuphys",
    "demos/sneakywoods",
    "demos/inference"
  ],
  "scripts": {
    "prepare:gguf": "node scripts/prepare-gguf-runtime.mjs",
    "postinstall": "node scripts/prepare-gguf-runtime.mjs",
    "test:geo-core": "npm --prefix packages/geo-core test",
    "test:geodata": "npm --prefix services/geodata test",
    "test:earth": "npm --prefix demos/earth test",
    "test:wxglobe": "npm --prefix demos/wxglobe test",
    "test:xr": "node --test demos/shared/xr/tests/*.test.js",
    "test:xr:browser": "node demos/tests/xr-browser-smoke.mjs",
    "test:physics": "node --test demos/shared/physics/particle-rigid/tests/*.test.js demos/shared/physics/vehicle/tests/*.test.js",
    "test:traffic": "node --test demos/shared/traffic/tests/*.test.js",
    "test:motorcycle": "npm --prefix demos/motorcycle test",
    "test:earth-platform:unit": "npm run test:geo-core && npm run test:geodata && npm run test:earth && npm run test:wxglobe && npm run test:xr && npm run test:xr:browser && npm run test:physics && npm run test:traffic && npm run test:motorcycle",
    "test:earth-platform:release": "npm run build:wxglobe && npm run build:earth && npm run build:motorcycle && node --test demos/tests/demo-ports.test.js demos/tests/demo-release.test.js && RUNTIME_SMOKE_DEMOS=wxglobe,earth,motorcycle DOCS_HOST=127.0.0.1 DOCS_PORT=43947 DEMO_WAIT_MS=500 DEMO_READY_TIMEOUT_MS=45000 node demos/tests/runtime-smoke.mjs",
    "test:earth-platform:live": "node demos/tests/earth-live-source.mjs",
    "sync:federal-highways": "node scripts/sync-federal-highways.mjs",
    "test:earth-platform": "npm run test:earth-platform:unit && npm run test:earth-platform:release",
    "backend": "bash scripts/pcserver.sh",
    "backend:dry-run": "bash scripts/pcserver.sh --dry-run",
    "test:backend": "node --test demos/tests/backend-server.test.js demos/tests/demo-release.test.js",
    "dev:relay": "npm --prefix peercompute run relay",
    "dev:hyperborea": "npm --prefix demos/hyperborea run dev -- --host",
    "dev:cubechat": "npm --prefix demos/cubechat run dev -- --host",
    "dev:planetgen": "npm --prefix demos/planetgen run dev -- --host",
    "dev:wxglobe": "npm --prefix demos/wxglobe run dev -- --host",
    "dev:geodata": "npm --prefix services/geodata start",
    "dev:geodata:public": "GEODATA_ALLOW_PUBLIC_OVERPASS=1 npm --prefix services/geodata start",
    "dev:earth": "npm --prefix demos/earth run dev -- --host",
    "dev:motorcycle": "npm --prefix demos/motorcycle run dev -- --host",
    "dev:earth-stack": "concurrently --kill-others-on-fail --names GEODATA,EARTH \"npm:dev:geodata\" \"npm:dev:earth\"",
    "dev:earth-stack:public": "concurrently --kill-others-on-fail --names GEODATA,EARTH \"npm:dev:geodata:public\" \"npm:dev:earth\"",
    "dev:motorcycle-stack": "concurrently --kill-others-on-fail --names GEODATA,MOTORCYCLE \"npm:dev:geodata\" \"npm:dev:motorcycle\"",
    "dev:motorcycle-stack:public": "concurrently --kill-others-on-fail --names GEODATA,MOTORCYCLE \"npm:dev:geodata:public\" \"npm:dev:motorcycle\"",
    "dev:earth-rides-stack:public": "concurrently --kill-others-on-fail --names GEODATA,EARTH,MOTORCYCLE \"npm:dev:geodata:public\" \"npm:dev:earth\" \"npm:dev:motorcycle\"",
    "dev:multiscale": "npm --prefix demos/multiscale run dev -- --host",
    "dev:universes": "npm --prefix demos/universes run dev -- --host",
    "dev:webgpuphys": "npm --prefix demos/webgpuphys run dev -- --host",
    "dev:sneakywoods": "npm --prefix demos/sneakywoods run dev -- --host",
    "dev:daddygo": "npm --prefix demos/daddygo run dev -- --host",
    "dev:fano-reactor": "npm --prefix demos/fano-reactor run dev -- --host",
    "dev:schrodinger": "npm --prefix demos/schrodinger run dev -- --host",
    "dev:netviz": "npm --prefix demos/netviz run dev -- --host",
    "dev": "bash scripts/dev-all.sh",
    "dev:local-relay": "bash scripts/dev-local-relay.sh",
    "dev:vpn-coturn": "bash scripts/dev-vpn-coturn.sh",
    "chaos:lab": "npm --prefix net-chaos-lab run chaos-lab --",
    "chaos-lab": "npm --prefix net-chaos-lab run chaos-lab --",
    "chaos-lab:full": "npm --prefix net-chaos-lab run full --",
    "chaos-lab:matrix": "npm --prefix net-chaos-lab run matrix --",
    "chaos-lab:matrix:demos": "npm --prefix net-chaos-lab run matrix:demos --",
    "chaos-lab:matrix:full": "npm --prefix net-chaos-lab run matrix:full --",
    "chaos-lab:matrix:demos:full": "npm --prefix net-chaos-lab run matrix:demos:full --",
    "chaos-lab:matrix:loop": "npm --prefix net-chaos-lab run matrix:loop --",
    "chaos-lab:matrix:demos:loop": "npm --prefix net-chaos-lab run matrix:demos:loop --",
    "chaos-lab:matrix:watch": "npm --prefix net-chaos-lab run matrix:watch --",
    "chaos-lab:matrix:smoke": "npm --prefix net-chaos-lab run matrix:smoke --",
    "chaos-lab:ipv6:min": "npm --prefix net-chaos-lab run ipv6:min --",
    "chaos-lab:ipv6:min:all": "npm --prefix net-chaos-lab run ipv6:min:all --",
    "chaos-lab:ipv6:loop": "npm --prefix net-chaos-lab run ipv6:loop --",
    "chaos-lab:image:build": "npm --prefix net-chaos-lab run image:build --",
    "chaos-lab:cleanup": "npm --prefix net-chaos-lab run cleanup --",
    "chaos-lab:deps": "npm --prefix net-chaos-lab run deps:python --",
    "docs:dev": "vite --config vite.docs.config.mjs",
    "docs:preview": "vite preview --config vite.docs.config.mjs",
    "test:runtime": "node demos/tests/runtime-smoke.mjs && node demos/tests/runtime-p2p.mjs",
    "test:runtime:p2p": "node demos/tests/runtime-p2p.mjs",
    "build:hyperborea": "npm --prefix demos/hyperborea run build",
    "build:cubechat": "npm --prefix demos/cubechat run build",
    "build:planetgen": "npm --prefix demos/planetgen run build",
    "build:wxglobe": "npm --prefix demos/wxglobe run build",
    "build:earth": "npm --prefix demos/earth run build",
    "build:motorcycle": "npm --prefix demos/motorcycle run build",
    "build:multiscale": "npm --prefix demos/multiscale run build",
    "build:universes": "npm --prefix demos/universes run build",
    "build:webgpuphys": "npm --prefix demos/webgpuphys run build",
    "build:sneakywoods": "npm --prefix demos/sneakywoods run build",
    "build:daddygo": "npm --prefix demos/daddygo run build",
    "build:fano-reactor": "npm --prefix demos/fano-reactor run build",
    "build:schrodinger": "npm --prefix demos/schrodinger run build",
    "build:netviz": "npm --prefix demos/netviz run build",
    "build:peercompute": "npm --prefix peercompute run build",
    "build:demos": "npm run build:hyperborea && npm run build:cubechat && npm run build:planetgen && npm run build:wxglobe && npm run build:earth && npm run build:motorcycle && npm run build:multiscale && npm run build:universes && npm run build:webgpuphys && npm run build:sneakywoods && npm run build:daddygo && npm run build:fano-reactor && npm run build:schrodinger && npm run build:netviz && npm run build:inference",
    "build:all": "bash scripts/build-all.sh",
    "build": "npm run build:all",
    "dev:inference": "npm --prefix demos/inference run dev -- --host",
    "build:inference": "npm --prefix demos/inference run build",
    "import:artifact": "node scripts/import-ipfs-artifact.mjs",
    "test:artifacts": "node --test peercompute/tests/unit/artifactStore.test.js peercompute/tests/unit/ipfsArtifactTransport.test.js peercompute/tests/unit/stateManager.artifacts.test.js",
    "test:inference": "node --test peercompute/tests/unit/modelInference.test.js peercompute/tests/unit/modelGpuErrors.test.js peercompute/tests/unit/modelMemoryBudgets.test.js peercompute/tests/unit/computeManager.residency.test.js peercompute/tests/unit/resourceLeaseBroker.test.js demos/tests/agents.test.js",
    "test:artifacts:browser": "node peercompute/tests/runtime/ipfs-artifacts.mjs",
    "test:artifacts:retention": "node peercompute/tests/runtime/artifact-retention.mjs",
    "test:inference:browser": "node peercompute/tests/runtime/model-inference.mjs",
    "test:diffusion": "node --test peercompute/tests/unit/diffusionCatalog.test.js peercompute/tests/unit/diffusionRuntime.test.js peercompute/tests/unit/peerInferenceNetwork.test.js peercompute/tests/unit/modelConsoleRuntime.test.js",
    "test:diffusion:browser": "node peercompute/tests/runtime/diffusion-inference.mjs",
    "test:gguf": "node --test peercompute/tests/unit/ggufArtifactReader.test.js peercompute/tests/unit/ggufRuntime.test.js peercompute/tests/unit/ggufService.test.js peercompute/tests/unit/ggufCatalog.test.js",
    "test:gguf:browser": "node peercompute/tests/runtime/gguf-inference.mjs",
    "test:peer-inference": "node --test peercompute/tests/unit/networkManager.inferenceRecovery.test.js peercompute/tests/unit/peerInferenceRecovery.test.js peercompute/tests/unit/peerInferenceNetwork.test.js peercompute/tests/unit/peerInferenceAudio.test.js peercompute/tests/unit/inferenceRouter.test.js peercompute/tests/unit/modelConsoleRuntime.test.js peercompute/tests/unit/residentModelRegistry.test.js",
    "test:peer-inference:browser": "node peercompute/tests/runtime/peer-inference.mjs",
    "test:global-chat": "node --test demos/tests/global-inference-chat.test.js demos/tests/global-chat-ui.test.js demos/tests/inference-global-integration.test.js",
    "test:inference:ui": "node --test demos/tests/prompt-style.test.js demos/tests/hold-to-record.test.js demos/tests/network-status.test.js demos/tests/inference-panel.test.js demos/tests/chat-image-input.test.js demos/tests/console-voice.test.js demos/tests/voice-session.test.js demos/tests/unified-chat.test.js",
    "test:agent-layer": "node --test peercompute/tests/unit/agentRecordStore.test.js peercompute/tests/unit/agentRecordStoreBrowser.test.js peercompute/tests/unit/agentRouter.test.js peercompute/tests/unit/agentModelAdapter.test.js peercompute/tests/unit/agentRuntime.test.js demos/tests/agent-console.test.js demos/tests/agent-chat-session.test.js",
    "test:agent-layer:browser": "node demos/tests/agent-browser.mjs",
    "test:world-agents": "node --test peercompute/tests/unit/agentWorldContracts.test.js peercompute/tests/unit/agentConversation.test.js demos/tests/world-agent-host.test.js demos/tests/world-agent-runtime.test.js demos/tests/world-agent-ui.test.js demos/tests/world-agent-voice-controls.test.js demos/tests/cubechat-agents.test.js demos/earth/tests/agentLayer.test.mjs demos/tests/earth-agent-browser.test.mjs peercompute/tests/unit/speechRuntime.test.js demos/tests/speech-lifecycle.test.js demos/tests/speech-audio.test.js",
    "test:world-speech:browser": "node demos/tests/speech-browser.mjs && node demos/tests/speech-audio-browser.mjs",
    "test:model-library": "node --test peercompute/tests/unit/artifactStore.test.js peercompute/tests/unit/modelConsoleRuntime.test.js peercompute/tests/unit/modelLibraryRuntime.test.js peercompute/tests/unit/modelDownload.test.js peercompute/tests/unit/modelDownloadBrowser.test.js peercompute/tests/unit/modelRetentionBrowser.test.js",
    "test:multimodal:browser": "node demos/tests/multimodal-console-browser.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "0.25.12",
    "geojson-vt": "^4.0.3",
    "mapshaper": "^0.7.55",
    "vite": "^6.4.1",
    "vt-pbf": "^3.1.3"
  },
  "dependencies": {
    "@libp2p/utils": "7.4.5",
    "three": "^0.182.0"
  },
  "overrides": {
    "@libp2p/utils": "7.4.5"
  }
}
